# Copiar a .env.production y reemplazar todos los valores marcados como CAMBIAR.
# El comando de despliegue debe usar: docker compose --env-file .env.production -f docker-compose.prod.yml ...

# Aplicación
NODE_ENV=production
PORT=3000
APP_PORT=8080
TZ=America/Bogota
CORS_ORIGIN=
# 1 = Nginx del compose; 2 si hay un proxy TLS adicional delante
TRUST_PROXY=1

# Base de datos (el host interno de Docker es "db").
# Mantener POSTGRES_USER/PASSWORD/DB sincronizados con DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_CLAVE_SEGURA
POSTGRES_DB=seguimiento_contrapartes
DATABASE_URL="postgresql://postgres:CAMBIAR_CLAVE_SEGURA@db:5432/seguimiento_contrapartes?schema=public"

# Autenticación
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Programación de notificaciones
SCHEDULE_NOTIFICATIONS_CRON="0 7 * * *"

# Archivos adjuntos
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg

# Administrador inicial (el seed es idempotente)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@cumplimiento.local
SEED_ADMIN_PASSWORD=CAMBIAR_CLAVE_INICIAL

# Base anual externa (solo lectura mediante Microsoft Graph o archivo local).
# Para file use EXTERNAL_WORKBOOK_PATH; para graph la API pública debe ser HTTPS.
EXTERNAL_DATA_ENABLED=false
EXTERNAL_DATA_SOURCE=graph
EXTERNAL_WORKBOOK_PATH=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ITEM_ID=
EXTERNAL_DATA_TABLE_NAME=
EXTERNAL_DATA_WORKSHEET_NAME=
EXTERNAL_DATA_COLUMN_MAP=
EXTERNAL_WEBHOOK_PUBLIC_URL=https://CAMBIARDominio/api
EXTERNAL_WEBHOOK_CLIENT_STATE=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
EXTERNAL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
EXTERNAL_GRAPH_TIMEOUT_MS=15000
EXTERNAL_FALLBACK_POLL_MS=900000
EXTERNAL_REFRESH_DEBOUNCE_MS=2000
EXTERNAL_MAX_ROWS=5000

# NestJS Observe (producción). Sin estas claves la telemetría queda desactivada.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=seguimiento-contrapartes-api
OBSERVE_SERVICE_VERSION=
