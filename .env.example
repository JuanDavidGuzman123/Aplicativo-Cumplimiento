# Entorno
NODE_ENV=development
PORT=3000

# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seguimiento_contrapartes?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seguimiento_contrapartes
POSTGRES_PORT=5432

# Autenticación
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Aplicación
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
TZ=America/Bogota
SCHEDULE_NOTIFICATIONS_CRON="0 7 * * *"
SCHEDULE_ANNUAL_NOTIFICATIONS_CRON="0 7 * * *"

# Archivos adjuntos
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg

# Usuario inicial (se crea solo si no existe)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@cumplimiento.local
SEED_ADMIN_PASSWORD=Admin123*

# Base anual externa (Excel en SharePoint/OneDrive o archivo local sincronizado)
# Esta fuente anual no escribe en PostgreSQL ni recibe datos de PostgreSQL.
# Habilite solo cuando estén definidas las credenciales o la ruta local.
EXTERNAL_DATA_ENABLED=false
# graph = leer con Microsoft Graph; file = leer un .xlsx local (OneDrive sync)
EXTERNAL_DATA_SOURCE=graph
EXTERNAL_WORKBOOK_PATH=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ITEM_ID=
# Opcional: nombre/id de tabla; si se omite se usa la primera tabla o la primera hoja.
EXTERNAL_DATA_TABLE_NAME=
EXTERNAL_DATA_WORKSHEET_NAME=
# Libro local de Colocadores independientes: se lee para /counterparties/sync-colocadores
# y se escriben solo Seguimiento Si/No y Observaciones desde risk-evaluation/reactivate.
EXTERNAL_COLOCADORES_WORKBOOK_PATH=
EXTERNAL_COLOCADORES_WORKSHEET_NAME=FR-SG-81
# Libro local de Clientes corporativos: se lee para /external-data/clientes
# y /counterparties/sync-clientes; se escriben solo Seguimiento Si/No y Observaciones
# en la hoja FR-SG-80.
EXTERNAL_CLIENTES_WORKBOOK_PATH=
EXTERNAL_CLIENTES_WORKSHEET_NAME=FR-SG-80
# Opcional: JSON con alias de columnas, por ejemplo {"code":"Codigo PDV","status":"Estado"}
EXTERNAL_DATA_COLUMN_MAP=
# Opcional: JSON con alias de columnas para FR-SG-80; si se omite se detectan
# automáticamente NIT, nombre, Año, Activo/Inactivo, Seguimiento y Observaciones.
EXTERNAL_CLIENTES_COLUMN_MAP=
# Carpetas locales montadas en el contenedor backend (lectura/escritura).
EXTERNAL_ARRIENDOS_WORKBOOK_DIR=./workbooks/arriendos
EXTERNAL_COLOCADORES_WORKBOOK_DIR=./workbooks/colocadores
EXTERNAL_CLIENTES_WORKBOOK_DIR=./workbooks/clientes
# URL base pública de la API, sin barra final; Graph publica en /external-data/webhook.
EXTERNAL_WEBHOOK_PUBLIC_URL=
EXTERNAL_WEBHOOK_CLIENT_STATE=
EXTERNAL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
EXTERNAL_GRAPH_TIMEOUT_MS=15000
EXTERNAL_FALLBACK_POLL_MS=900000
EXTERNAL_REFRESH_DEBOUNCE_MS=2000
EXTERNAL_MAX_ROWS=5000

# Observabilidad (solo se envía en producción con ambas claves configuradas)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=seguimiento-contrapartes-api
OBSERVE_SERVICE_VERSION=
